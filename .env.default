# Local environment defaults for courtyard. During installation, copy this file:
#
#     cp .env.default .env
#
# then uncomment and change what your machine needs. `.env` is gitignored; both
# docker compose and the Makefile read it. Everything works without a .env when
# the defaults suit your machine.

# Host port for the compose postgres. Change it if 5432 is already taken by a
# local postgres. The hub, tests and runbook scripts all follow this variable;
# a full DATABASE_URL (if you ever set one) wins over it.
#COURTYARD_PG_PORT=5432

# Port for the hub and its WebUI.
#COURTYARD_PORT=2626