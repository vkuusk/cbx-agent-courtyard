// Agent Courtyard — 30,000 ft component view (discussion artifact).
// Source of truth for the picture: courtyard-30k-view.excalidraw (edited on
// excalidraw.com); this DOT mirrors its layout for graph-based discussion.
// Render: dot -Tsvg courtyard-30k-view.dot -o rendered.svg
//
// Legend (drawn as caption text in the excalidraw/PNG version):
//   each agent = a Claude Code session in its own terminal, in its own project directory.
//   the hub = the only communication path between agents providing discovery
//             and conversation supervision.
digraph courtyard_30k {
    label="Agent Courtyard — 30,000 ft";
    labelloc=t;
    fontname="Helvetica";
    rankdir=LR;
    node [fontname="Helvetica", shape=box, style=rounded];
    edge [fontname="Helvetica", fontsize=10];

    // palette: green = the human · blue = agents · yellow = the hub · pink = the board
    // graphviz has no person/"user" shape; the emoji mirrors the excalidraw user icon
    operator [label="👤 Operator\n(human)", shape=ellipse, style=filled, fillcolor="#b2f2bb"];
    board    [label="Board (WebUI)\nserved by the hub", style="rounded,filled", fillcolor="#ffc9c9"];
    agent_a  [label="agent A (main)", style="rounded,filled", fillcolor="#a5d8ff"];
    hub      [label="Hub\nregistry · lines · turns\ngate · shift · archive",
              style="rounded,filled", fillcolor="#ffec99"];
    agent_b  [label="agent B", style="rounded,filled", fillcolor="#a5d8ff"];
    agent_n  [label="agent …", style="rounded,dashed,filled", fillcolor="#a5d8ff"];

    // the spine: the operator's day-to-day path, left to right
    operator -> agent_a [label="works in terminal"];
    agent_a  -> hub     [dir=both, label="MCP"];
    hub      -> agent_b [dir=both, label="MCP"];
    hub      -> agent_n [dir=both, label="MCP"];

    // the same operator works in any agent's terminal directly;
    // in the excalidraw version this edge sweeps below the hub to agent B
    operator -> agent_b [label="works in terminal (different task)", constraint=false];

    // the supervision layer, arched above the spine
    operator -> board   [label="watches · gate verdicts"];
    board    -> hub     [dir=both];
}
